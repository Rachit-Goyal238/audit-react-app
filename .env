# Standalone Audit Report Generator & Dispatcher Configuration
# -------------------------------------------------------------

# Gotenberg LibreOffice Conversion Endpoint
# In local development with LibreOffice installed, leave this blank or http://localhost:5173 to use the built-in native bridge.
# For production or Docker deployments, set to your Gotenberg service URL (e.g. http://localhost:3000 or https://your-cloud-run.a.run.app).
VITE_GOTENBERG_URL=

# Optional Gotenberg API Bearer Token
VITE_GOTENBERG_API_KEY=

# Google OAuth 2.0 Web Client ID for direct Gmail drafting
# Create in Google Cloud Console -> APIs & Services -> Credentials -> Create OAuth client ID (Web Application)
# Authorized JavaScript origin: http://localhost:5173 (and your production domain)
VITE_GOOGLE_CLIENT_ID=
